# Copy to .env.local for local dev. Each of local/staging/production points
# at its own Supabase project, per the Session 0 environment-separation rule
# in trib4l-build-from-zero.md — never share a Supabase project across
# environments.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- This app's own public origin (S1) ---
# Where OAuth providers send people back to: <origin>/auth/callback. Optional
# locally, where it falls back to the request's own Origin; REQUIRED in staging
# and production, which sit behind a proxy whose Host header is not the public
# name. No trailing slash. Must also appear in supabase/config.toml's
# additional_redirect_urls, or Supabase refuses the redirect.
NEXT_PUBLIC_SITE_URL=

# --- OAuth providers (S1) ---
# Read by BOTH the Supabase container (which performs the exchange) and this
# app (which only checks whether a client id is present, to decide whether to
# offer the button). The client id is public by design; only the secret is
# sensitive, and only the container reads it.
#
# A provider stays `enabled = false` in supabase/config.toml until its client
# id is filled in here: enabling one with an empty client id makes the CLI
# refuse to parse the config at all. Fill these in and flip the flag together.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Sentry ---
# Filled in by `npx @sentry/wizard@latest -i nextjs` once a Sentry org/project exists.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Stripe Connect (test mode until Session 13) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Mux (Session 11) ---
# Names match @mux/mux-node's own defaults exactly (new Mux() reads all
# five straight from env, no explicit constructor options needed).
# MUX_WEBHOOK_SECRET is per-endpoint, not account-wide -- issued by Mux
# only after you register the webhook URL in the dashboard, so it's the
# last of these five you'll have.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# --- Transactional email (Session 4) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
