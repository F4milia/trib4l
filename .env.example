# Copy to .env.local for local dev. Each of local/staging/production points
# at its own Supabase project, per the Session 0 environment-separation rule
# in trib4l-build-from-zero.md — never share a Supabase project across
# environments.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry ---
# Filled in by `npx @sentry/wizard@latest -i nextjs` once a Sentry org/project exists.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Stripe Connect (test mode until Session 13) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Mux (test env until Session 11) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# --- Transactional email (Session 4) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
