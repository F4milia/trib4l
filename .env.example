# Copy to .env.local for local dev. Each of local/staging/production points
# at its own Supabase project, per the Session 0 environment-separation rule
# in trib4l-build-from-zero.md — never share a Supabase project across
# environments.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- This app's own public origin (S1) ---
# Where OAuth providers send people back to: <origin>/auth/callback. Optional
# locally, where it falls back to the request's own Origin; REQUIRED in staging
# and production, which sit behind a proxy whose Host header is not the public
# name. No trailing slash. Must also appear in supabase/config.toml's
# additional_redirect_urls, or Supabase refuses the redirect.
NEXT_PUBLIC_SITE_URL=

# --- OAuth providers (S1) ---
# Read by BOTH the Supabase container (which performs the exchange) and this
# app (which only checks whether a client id is present, to decide whether to
# offer the button). The client id is public by design; only the secret is
# sensitive, and only the container reads it.
#
# A provider stays `enabled = false` in supabase/config.toml until its client
# id is filled in here: enabling one with an empty client id makes the CLI
# refuse to parse the config at all. Fill these in and flip the flag together.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Turnstile (S2 signup abuse protection) ---
# Cloudflare Turnstile. The SITE key is public by design and is inlined into the
# client bundle; only the SECRET is sensitive, and only the Supabase auth
# container reads it (GoTrue performs the verification -- the app never calls
# siteverify, because the public anon key means /auth/v1/signup is reachable
# without the app's server actions).
#
# The widget renders on a form only when the site key is present, so leaving
# these blank is a supported state: local development and CI run with no captcha.
# Cloudflare publishes always-passes / always-blocks test keys for exactly this;
# see docs/f4milia/s2-turnstile-setup.md before filling in real ones.
#
# `[auth.captcha] enabled` in supabase/config.toml stays false until the secret
# is set in the environment the CLI reads. Flip the flag and fill the secret in
# the SAME change -- captcha enabled with no secret refuses every signup.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sentry ---
# TWO DSN variables, not one. The client config (instrumentation-client.ts) runs
# in the browser and needs NEXT_PUBLIC_ inlining; the server and edge configs do
# not. A DSN in a client bundle is normal and is not what invariant 12 guards --
# the invariant is that the PROJECT is chosen per environment rather than
# compiled in, so CI and staging never report into production.
#
# Both unset is a supported state: Sentry no-ops rather than throwing, which is
# the correct default until a non-production project exists.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Stripe Connect (test mode until Session 13) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Mux (Session 11) ---
# Names match @mux/mux-node's own defaults exactly (new Mux() reads all
# five straight from env, no explicit constructor options needed).
# MUX_WEBHOOK_SECRET is per-endpoint, not account-wide -- issued by Mux
# only after you register the webhook URL in the dashboard, so it's the
# last of these five you'll have.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# --- Transactional email (Session 4 / Wave 1 E1) ---
# Setup runbook, including the SPF/DKIM records: docs/email-sending-domain.md
# The sending domain is already decided -- f4milia.brandlamb.com, per
# docs/session-4-checklist.md. The RESEND_API_KEY / EMAIL_FROM_ADDRESS values
# already in Vercel predate that decision and do not correspond to it.
#
# EMAIL_DELIVERY_MODE governs whether anything actually leaves:
#   unset / dry-run  nothing is sent; sendEmail() reports what it would do.
#                    This is the default on purpose, and deliberately NOT
#                    inferred from NODE_ENV -- a preview deployment and
#                    production are both NODE_ENV=production, and that guess
#                    sends real mail to real members from a branch build.
#   redirect         real delivery, every recipient rewritten to
#                    EMAIL_TEST_INBOX. Staging setting: "delivers in staging"
#                    and "staging never sends real mail" at the same time.
#   live             delivered to the member. Refuses to start unless
#                    EMAIL_FROM_ADDRESS's domain IS EMAIL_SENDING_DOMAIN,
#                    because SPF and DKIM align on the domain and mail from
#                    anywhere else fails both.
EMAIL_DELIVERY_MODE=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_SENDING_DOMAIN=
EMAIL_TEST_INBOX=

# --- Web push (Wave 4 / N1) ---
# Generated once, by you, not obtained from a vendor:
#     npx web-push generate-vapid-keys
# The public key is public by design -- the browser needs it to create a
# subscription. VAPID_SUBJECT is a mailto: address you own, which push services
# use to reach you about a misbehaving sender.
#
# ROTATING THE PAIR INVALIDATES EVERY EXISTING SUBSCRIPTION. Generate once and
# store it properly the first time.
#
# All three unset is a supported state: lib/push reports "not configured" and
# sends nothing, so the app boots and the suite passes without them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Inngest (Wave 4 / N1) ---
# From the Inngest dashboard. Unset means the route still mounts and nothing is
# sent -- unconfigured is a no-op, never an exception.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Test-only switches ---
# Set by playwright.config.ts in its own webServer block, and ignored unless
# NODE_ENV is not "production" (which `next build` pins). A dev server started
# by hand does NOT get this, which is why running a spec twice by hand hits
# S2's five-per-fifteen-minutes limiter and fails at signIn -- a symptom that
# looks like the feature under test.
AUTH_RATE_LIMIT_DISABLED=
E2E_BASE_URL=

# --- NOT HERE ON PURPOSE: the AI model keys ---
# ANTHROPIC_API_KEY and OPENAI_API_KEY belong in SUPABASE EDGE FUNCTION SECRETS
# (`supabase secrets set`), never in this file and never in the Vercel
# environment -- not even as server-only variables.
#
# Invariant 2: AI is server-side only, in Edge Functions. A key that exists in
# the Next.js process can be imported into a client component by accident, and
# A1's acceptance greps the build output for exactly that. Keeping them out of
# the app's environment entirely removes the failure rather than guarding it.
#
# tests/env-manifest.test.ts asserts these names appear in neither this file nor
# any bundled source. See docs/f4milia/secrets-and-env.md.
